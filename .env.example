# ---------- apps/api ----------
PORT=4000
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000

# LLM for the specialist agents. Leave empty to run the deterministic engine only.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Pine Labs (Plural) checkout. Use UAT/test credentials during the hackathon.
PINELABS_ENV=uat
PINELABS_MERCHANT_ID=
PINELABS_CLIENT_ID=
PINELABS_CLIENT_SECRET=

# AgenticOrg (Pine Labs) agent webhook shared secret
AGENTICORG_WEBHOOK_SECRET=

# ---------- apps/web ----------
# Where the browser reaches the API. Empty = the web app runs its built-in demo engine.
NEXT_PUBLIC_API_URL=http://localhost:4000
