# Copy to .env (API) and set NEXT_PUBLIC_API_URL in apps/web/.env.local (web).

# ---------- apps/api ----------
PORT=4000
# Where the API is reachable from the internet (needed for Telegram webhooks, Pine Labs and Google redirects).
# Leave empty locally: Telegram falls back to polling. On Render this defaults to RENDER_EXTERNAL_URL.
PUBLIC_API_URL=
# Where the web app lives (payment and sign-in redirects land here).
WEB_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
DATA_DIR=./data
SESSION_SECRET=change-me-to-a-long-random-string
# Unlocks GET /api/admin/stats?key=... (timestamped signups, payments, agent activity for judges).
ADMIN_KEY=

# Google OAuth 2.0 (Google Cloud Console → APIs & Services → Credentials → OAuth client ID, type "Web application").
# Authorised redirect URI: <PUBLIC_API_URL>/api/auth/google/callback   (locally http://localhost:4000/api/auth/google/callback)
# Also enable the Google Calendar API for the project.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Telegram member agents: create a bot with @BotFather and paste its token.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# WhatsApp member agents through the Twilio sandbox.
# Webhook (Twilio console → Messaging → Try it out → WhatsApp sandbox settings): <PUBLIC_API_URL>/api/channels/whatsapp/twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Pine Labs Online hosted checkout. Empty = clearly labelled simulated checkout.
PINELABS_ENV=uat
PINELABS_CLIENT_ID=
PINELABS_CLIENT_SECRET=

# ---------- apps/web ----------
NEXT_PUBLIC_API_URL=http://localhost:4000
